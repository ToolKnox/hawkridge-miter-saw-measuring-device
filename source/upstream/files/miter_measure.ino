const char index_htm[] PROGMEM = {"<!doctype html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"author\" content=\"Warren Wiens\">\n  <title>Miter Measure</title>\n\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\">\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/css/bootstrap.min.css\" rel=\"stylesheet\"\n    integrity=\"sha384-+0n0xVW2eSR5OomGNYDnhzAbDsOXxcvSN1TPprVMTNDbiYZCxYbOOl7+AMvyTG2x\" crossorigin=\"anonymous\">\n  <link rel=\"stylesheet\" href=\"https://use.fontawesome.com/releases/v5.8.2/css/all.css\">\n\n\n  <style>\n    .measure {\n      font-weight: 400;\n      font-size: 120px;\n      color: black;\n    }\n\n    .measurepart {\n      font-weight: 400;\n      font-size: 55px;\n      color: black;\n      padding-left: 10px;\n    }\n  </style>\n  <script>\n    function calstep1() {\n      window.location = 'cal-1.htm';\n    }\n    function changeunits() {\n      var xhttp = new XMLHttpRequest();\n      xhttp.onreadystatechange = function () {\n        if (this.readyState == 4 && this.status == 200) {\n          document.getElementById('measure_large').innerHTML = \"0\";\n          document.getElementById('measure_small').innerHTML = \"\";\n        }\n      };\n      xhttp.open('GET', 'changeunits.htm', true);\n      xhttp.send();\n    }   \n    function loadDoc() {\n      var xhttp = new XMLHttpRequest();\n      xhttp.onreadystatechange = function () {\n        if (this.readyState == 4 && this.status == 200) {\n          document.getElementById('measure_large').innerHTML = \"0\";\n          document.getElementById('measure_small').innerHTML = \"\";\n        }\n      };\n      xhttp.open('GET', 'reset.htm', true);\n      xhttp.send();\n    }\n    ws = new WebSocket('ws://' + window.location.hostname + ':81/');\n    ws.onmessage = function (event) {\n      var strMessage = event.data;\n      var strSplitted = strMessage.split('#');\n      if (strSplitted[0]=='Inches') {\n        document.getElementById('units').innerHTML = \"Inches\";\n        document.getElementById('measurebox').innerHTML = \"<div class='col align-self-start text-end measure' id='measure_large'></div><div class='col align-self-center text-start measurepart' id='measure_small'></div>\";\n        document.getElementById('measure_large').innerHTML = strSplitted[1];\n        document.getElementById('measure_small').innerHTML = strSplitted[2];\n      } else {\n        document.getElementById('measurebox').innerHTML = \"<div class='col align-self-center  measure' id='measure_large'></div>\";\n        document.getElementById('units').innerHTML = \"Millimeters\";\n        document.getElementById('measure_large').innerHTML = strSplitted[1];\n      }\n    }\n\n  </script>\n\n</head>\n\n<body>\n\n  <main>\n\n    <div class=\"px-4 py-2 my-5 text-center\">\n      <img class=\"d-block mx-auto mb-4\" src=\"logo.png\" alt=\"\" width=\"250px\">\n\n      <div class=\"col-lg-6 mx-auto\">\n        <div id=\"measurebox\" class=\"row justify-content-center\">\n          <div class='col align-self-center  measure' id='measure_large'>0</div>\n        </div>\n        <div class=\"row justify-content-center\">\n          <div class=\"col align-self-center\">\n            <H4 id=\"units\">Inches</H4>\n          </div>\n        </div>\n        <div class=\"d-grid gap-2 col-12 mx-auto\">\n          <button type=\"button\" class=\"btn btn-primary btn-rounded \" onclick='loadDoc()'><i class=\"fas fa-undo-alt\"></i> Reset Distance</button>\n          <button type=\"button\" class=\"btn btn-secondary btn-rounded\" onclick='changeunits()'><i class=\"fas fa-ruler-horizontal\"></i> Change Unit of Measure</button>\n          <button type=\"button\" class=\"btn btn-secondary btn-rounded\" onclick='calstep1()'><i class=\"fas fa-cog\"></i> Calibrate Device</button>\n        </div>\n      </div>\n\n    </div>\n\n  </main>\n\n</body>\n\n</html>"};
