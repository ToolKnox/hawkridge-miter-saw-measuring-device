int clientnum = 0;

ESP8266WebServer server(80);
WebSocketsServer webSocket = WebSocketsServer(81);

const char *ssid = "your-ssid";
const char *password = "your-password";

const char *ap_ssid = "miterwifi";
const char *ap_password = "measureit";
//#########################################################

//########## FUNCTION TO UPDATE WEBSOCKET #################
void updateDisplay(int currentValue)
{

  String strNegative = "";
  String measurements =  "";

  if (currentValue < 0)
  {
    currentValue = -currentValue;
    strNegative = "-";
  }

  if (unitOfMeasure == 0) {                                                 //0 means Inches
    int inchValue = currentValue / inchConversionFactor;
    int inchPartial = currentValue % inchConversionFactor;
    int inchPercent = ((inchPartial * 100) / inchConversionFactor);
    int intArray = (inchPercent * 16) / 100;

    String breakout = results[intArray];

    //measurements = strNegative + String(inchValue) + "#" + breakout + "#Inches";
    measurements = "Inches#" + strNegative + String(inchValue) + "#" + breakout;
  } else {
    mmConversionFactor =inchConversionFactor / 25.4;
    int mmValue = currentValue / mmConversionFactor;
    //int mmPartial = currentValue % mmConversionFactor;


    //measurements = strNegative + String(mmValue) + "#." + mmPartial + "#Millimeters";
    measurements = "Millimeters#" + strNegative + String(mmValue);
  }

  Serial.println(measurements);

  webSocket.sendTXT(clientnum, measurements);
}
//#########################################################

//########## CONFIGURE WEB REQUEST HANDLERS ###############
void pngCache()
{
  server.sendHeader("Pragma", "public");
  server.sendHeader("Cache-Control", "max-age=86400");
  server.sendHeader("Content-Type", "image/png");
}

void sendNoCache()
{
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Cache-Control", "no-cache, must-revalidate");
  server.sendHeader("Content-Type", "text/html");
}

void handleReset()
{
  //Serial.println("Web: Reset Function - AJAX");
  counter = 0;
  updateDisplay(counter);
  server.send(200, "text/html", "0");
  Serial.println("reset function");
}

//Section to declare HTML functions
void handlecal_1_htm()
{
  sendNoCache();
  server.send_P(200, "text/html", cal_1_htm);
  Serial.println("cal_1.htm");
}
void handlecal_2_htm()
{
  //Reset counter to 0 to start calibration
  counter = 0;
  sendNoCache();
  server.send_P(200, "text/html", cal_2_htm);
  Serial.println("cal_2.htm");
}
void handlecal_3_htm()
{
  //Recalculate conversion factor
  float counterVar = counter;
  inchConversionFactor = counterVar / 10;
  mmConversionFactor = counterVar / 254;
  counter = 0;

  EEPROM.begin(EEPROM_SIZE);
  int address = 0;
  EEPROM.put(address, inchConversionFactor);
  EEPROM.commit();

  sendNoCache();
  server.send_P(200, "text/html", cal_3_htm);
  Serial.println("cal_3.htm");

  updateDisplay(counter);
}
void handleindex_htm()
{
  counter = 0;
  updateDisplay(counter);
  sendNoCache();
  server.send_P(200, "text/html", index_htm);
  Serial.println("index.htm");
}
void handleNotFound()
{
  sendNoCache();
  server.send_P(400, "text/html", file_not_found_404);
  Serial.println("404 error");
}
void handleWifi_htm()
{
  sendNoCache();
  String tmpWifi = String(wifi_htm);
  tmpWifi.replace("[@ipaddress@]", WiFi.localIP().toString());
  server.send(200, "text/html", tmpWifi);
  Serial.println("wifi.htm");
}
void handleUnits()
{
  //Change units of measure
  if (unitOfMeasure==0) {
    unitOfMeasure=1;
  } else {
    unitOfMeasure=0;
  }
  counter = 0;
  updateDisplay(counter);
  Serial.print("changeunits: ");
  Serial.println(unitOfMeasure);
  server.send(200, "text/html", "ok");
}
//Section to declare image functions
void handlefavicon_ico()
{
  pngCache();
  server.send_P(200, "image/ico", favicon_ico, sizeof(favicon_ico));
  Serial.println("favicon.ico");
}
void handlelogo_png()
{
  pngCache();
  server.send_P(200, "image/png", logo_png, sizeof(logo_png));
  Serial.println("logo.png");
}
//#########################################################

//########## INTERRUPT HANDLER THAT READS ENCODER #########
ICACHE_RAM_ATTR void encoder()
{

  if (digitalRead(12) == HIGH)
  {
    if (digitalRead(14) == HIGH)
    {
      counter++;
    }
    else
    {
      counter--;
    }
  }
}
//#########################################################

//########## CONFIGURE WEBSOCKET TO SEND DATA TO DEVICE  ##
void webSocketEvent(uint8_t num, WStype_t type, uint8_t *payload, size_t length)
{
  if (type == WStype_CONNECTED)
  {
    clientnum = num;
  }
}
//#########################################################

//########## Setup function  ##############################
void setup()
{

  //Setup serial output
  Serial.begin(9600);
  Serial.println("");
  delay(10);

  //Set pin mode for WiFi LED and turn it off
  pinMode(LED, OUTPUT);
  digitalWrite(LED, LOW);

  //Init EEPROM
  EEPROM.begin(EEPROM_SIZE);
  int address = 0;
  int saveconversion = 0;
  EEPROM.get(address, saveconversion);
  Serial.println(saveconversion);

  //Create access point - to display IP Address
  IPAddress local_IP(10, 10, 10, 1);
  IPAddress gateway(10, 10, 10, 1);
  IPAddress subnet(255, 255, 255, 0);
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAPConfig(local_IP, gateway, subnet);
  WiFi.softAP(ap_ssid,ap_password);

  //Connecting to a WiFi network
  Serial.print("Connecting to ");
  Serial.println(ssid);

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);
    if (blinkvar == 0)
    {
      digitalWrite(LED, LOW);
      blinkvar = 1;
    }
    else
    {
      digitalWrite(LED, HIGH);
      blinkvar = 0;
    }
    Serial.print(".");
  }

  //Turn on WiFi LED
  digitalWrite(LED, HIGH);

  //Display wifi details
  Serial.print("Connected to ");
  Serial.println(ssid);
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());

  //********** DEFINE WEB SERVER HANDLING FUNCTIONS ************
  //Section to declare HTML handlers
  server.on("/cal-1.htm", handlecal_1_htm);
  server.on("/cal-2.htm", handlecal_2_htm);
  server.on("/cal-3.htm", handlecal_3_htm);
  server.on("/index.htm", handleindex_htm);
  server.on("/", handleindex_htm);
  server.on("/reset.htm", handleReset);
  server.on("/changeunits.htm", handleUnits);
  server.on("/wifi.htm", handleWifi_htm);
  server.on("/favicon.ico", handlefavicon_ico);
  server.on("/logo.png", handlelogo_png);
  server.onNotFound(handleNotFound);
  server.begin();
  //************************************************************

  //********** INITIALIZE WEBSOCKET ****************************
  webSocket.begin();
  webSocket.onEvent(webSocketEvent);
  //************************************************************

  //********** INITIALIZE ENCODER PINS *************************
  pinMode(12, INPUT_PULLUP); // internal pullup input pin 2
  pinMode(14, INPUT_PULLUP); // internalเป็น pullup input pin 3
  attachInterrupt(12, encoder, RISING);
  //************************************************************
}
//#########################################################

//########## Loop function  ###############################
void loop()
{

  server.handleClient();
  webSocket.loop();

  if (Serial.available() > 0)
  {
    String received = Serial.readString();
    if (int(received[0]) == 0)
    {
      counter = 0;
      updateDisplay(counter);
    }
  }

  if (counter != temp)
  {
    updateDisplay(counter);
    temp = counter;
  }
}
